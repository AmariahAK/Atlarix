{
  "name": "atlarix",
  "productName": "Atlarix",
  "version": "14.33.0",
  "description": "The private AI workstation for engineering teams — your code stays on your machine, with managed Atlarix Core models, any-model BYOK across 145+ providers, and local execution.",
  "main": ".vite/build/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/AmariahAK/Atlarix.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "clean": "rimraf out scaffold/node_modules",
    "start": "electron-forge start",
    "dev:engine": "cross-env ATLARIX_ENGINE_URL=http://localhost:8080/v1 npm start",
    "staging:engine": "cross-env ATLARIX_ENGINE_URL=https://staging---dyad-llm-engine-kq7pivehnq-uc.a.run.app/v1 npm start",
    "package": "npm run clean && cross-env NODE_OPTIONS=--max-old-space-size=8192 electron-forge package",
    "package:verify": "npm run package && npm run measure-package-size",
    "self-test:packaged": "node scripts/run-packaged-self-test.mjs",
    "ci:package": "electron-forge package",
    "ci:build:win": "node scripts/win-ci-vite.mjs && node scripts/win-ci-package.mjs",
    "ci:make": "electron-forge make",
    "ci:installers": "electron-forge make --skip-package",
    "make": "npm run clean && cross-env NODE_OPTIONS=--max-old-space-size=8192 electron-forge make",
    "make:ci-simulate": "node scripts/simulate-ci-make.mjs --profile=fixed --arch=arm64",
    "make:ci-verify": "node scripts/verify-ci-package-out.mjs --stage make --platform darwin --arch arm64",
    "publish": "npm run clean && cross-env NODE_OPTIONS=--max-old-space-size=8192 electron-forge publish",
    "models:snapshot": "node scripts/fetch-models-snapshot.mjs",
    "verify:lockfile": "node scripts/verify-npm-lock-registry.mjs",
    "verify-release": "node scripts/verify-release-assets.js",
    "measure-package-size": "node scripts/measure-package-size.mjs",
    "verify-renderer-bundle": "node scripts/verify-renderer-bundle.mjs",
    "email:user-feedback": "node scripts/send-user-feedback-email.mjs",
    "email:user-feedback:dry-run": "node scripts/send-user-feedback-email.mjs --dry-run",
    "email:v85-upgrade": "node scripts/send-v85-upgrade-emails.mjs",
    "email:v85-upgrade:dry-run": "node scripts/send-v85-upgrade-emails.mjs --dry-run",
    "ts": "npm run ts:main && npm run ts:tests",
    "ts:main": "node node_modules/typescript/lib/tsc.js -p tsconfig.main.json --noEmit",
    "ts:tests": "node node_modules/typescript/lib/tsc.js -p tsconfig.tests.json --noEmit",
    "lint": "npx oxlint --fix",
    "lint:fix": "npx oxlint --fix --fix-suggestions --fix-dangerously",
    "knip": "knip",
    "db:generate": "drizzle-kit generate",
    "db:bundle-sql": "node scripts/generate-bundled-sql-migrations.mjs",
    "postdb:generate": "npm run db:bundle-sql",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "prettier:check": "npx prettier --check .",
    "prettier": "npx prettier --write .",
    "presubmit": "npm run prettier:check && npm run lint",
    "test": "vitest run",
    "audit:tools": "vitest run src/__tests__/tool-registry-audit.test.ts",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "extract-codebase": "ts-node scripts/extract-codebase.ts",
    "init-precommit": "husky",
    "pre:e2e": "cross-env E2E_TEST_BUILD=true npm run package",
    "e2e": "playwright test",
    "e2e:shard": "playwright test --shard",
    "postinstall": "patch-package && node node_modules/electron/install.js || true",
    "build:headless": "node scripts/build-headless.mjs",
    "build:win-sandbox": "cargo build --release --manifest-path native/atlarix-sandbox/Cargo.toml",
    "build:linux-sandbox": "cargo build --release --manifest-path native/atlarix-sandbox-linux/Cargo.toml",
    "check": "npm run check:ts && npm run check:lint",
    "check:ts": "node node_modules/typescript/lib/tsc.js -p tsconfig.app.json --noEmit",
    "check:lint": "oxlint src",
    "check:sandbox": "node scripts/check-sandbox-helpers.mjs"
  },
  "keywords": [
    "ai",
    "coding",
    "assistant",
    "electron",
    "typescript",
    "atlarix"
  ],
  "author": {
    "name": "NorahLabs",
    "email": "support@norahlabs.com",
    "url": "https://norahlabs.com"
  },
  "license": "PROPRIETARY",
