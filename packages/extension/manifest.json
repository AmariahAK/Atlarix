{
  "key": "",
  "manifest_version": 3,
  "name": "Atlarix",
  "version": "0.1.0",
  "description": "Drives the browser you are already signed into.",
  "minimum_chrome_version": "116",
  "permissions": [
    "identity",
    "storage",
    "sidePanel",
    "tabs",
    "scripting",
    "tabGroups",
    "debugger"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Atlarix",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "128": "icons/128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "128": "icons/128.png"
  }
}
