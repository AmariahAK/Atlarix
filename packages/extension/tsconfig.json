{
  // Deliberately NOT extending the app config. That one targets Electron main
  // and the React renderer — Node types, JSX, Electron globals. A content script
  // has none of those, and inheriting them is how `process.env` or `require`
  // sneaks into a bundle that cannot run it.
  //
  // `types: []` is load-bearing: with no entry, TypeScript pulls in EVERY
  // package under node_modules/@types, which here would hand the extension
  // Node's globals and quietly undo the isolation above.
  "compilerOptions": {
    "tsBuildInfoFile": "../../node_modules/.tmp/tsconfig.extension.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [],
    // For `manifest.json` alone, so `auth/redirect.test.ts` can re-derive the
    // extension id from the REAL key rather than from a copy of it. Reading it
    // with `node:fs` would have been the obvious move and `types: []` correctly
    // refused — a test that reaches for Node is one edit away from a source file
    // that does. Importing it costs nothing at runtime: the manifest is data,
    // and no source file has a reason to import it (the runtime path is
    // `chrome.runtime.getManifest()`, which needs no permission).
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    // `@/*` reaches back into the app's src so the page-realm scripts are
    // IMPORTED rather than copied. A second copy of the walker is a second
    // contract, and the model was promised one.
    "paths": {
      "@/*": ["../../src/*"]
    }
  },
  "include": ["src"]
}
