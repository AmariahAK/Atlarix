# Pin the publish target to public npm, regardless of global npm config.
#
# This machine also works against a private AWS CodeArtifact registry for an
# unrelated project, and `aws codeartifact login --tool npm` writes a GLOBAL
# `registry=` line into ~/.npmrc. Without this file, the next `npm publish` here
# would happily push Atlarix to that private registry — wrong destination, and a
# proprietary bundle in someone else's namespace.
#
# The repo root has its own .npmrc for the same reason, but npm resolves the
# project .npmrc from the invocation directory, and publishing happens from HERE.
registry=https://registry.npmjs.org/
