{
  "name": "atlarix",
  "displayName": "Atlarix — AI Coding Agent (Any Model, Your Own Key)",
  "description": "AI coding agent for VS Code, Cursor, Kiro and Windsurf. Use Claude, GPT, Gemini, GLM, DeepSeek or local models with your own API key, or Atlarix Auto. Plan, Build, Debug and Review modes; every edit waits for your approval.",
  "version": "15.13.2",
  "publisher": "atlarix",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "icon": "media/icon.png",
  "homepage": "https://www.atlarix.dev/docs/guides/editors",
  "repository": {
    "type": "git",
    "url": "https://github.com/AmariahAK/atlarix-releases"
  },
  "bugs": {
    "url": "https://github.com/AmariahAK/atlarix-releases/issues"
  },
  "pricing": "Free",
  "galleryBanner": {
    "color": "#0a0a0a",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages",
    "Machine Learning"
  ],
  "keywords": [
    "ai coding agent",
    "ai agent",
    "coding assistant",
    "ai pair programmer",
    "autonomous agent",
    "byok",
    "bring your own key",
    "openai",
    "gpt",
    "claude",
    "anthropic",
    "gemini",
    "deepseek",
    "glm",
    "openrouter",
    "ollama",
    "local llm",
    "code review",
    "debugging",
    "refactor",
    "plan mode",
    "agent mode",
    "chat",
    "mcp",
    "browser automation",
    "chrome",
    "cursor",
    "kiro",
    "acp",
    "atlarix"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "atlarix",
          "title": "Atlarix",
          "icon": "media/rix-glyph.svg"
        }
      ]
    },
    "views": {
      "atlarix": [
        {
          "type": "webview",
          "id": "atlarix.chat",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "atlarix.newChat",
        "title": "New chat",
        "category": "Atlarix",
        "icon": "$(add)"
      },
      {
        "command": "atlarix.openInTab",
        "title": "Open chat in an editor tab",
        "category": "Atlarix",
        "icon": "$(link-external)"
      },
      {
        "command": "atlarix.history",
        "title": "Past chats",
        "category": "Atlarix",
        "icon": "$(history)"
      },
      {
        "command": "atlarix.addSelection",
        "title": "Add selection to chat",
        "category": "Atlarix"
      },
      {
        "command": "atlarix.addFile",
        "title": "Add file to chat",
        "category": "Atlarix"
      },
      {
        "command": "atlarix.focus",
        "title": "Focus chat",
        "category": "Atlarix"
      },
      {
        "command": "atlarix.signIn",
        "title": "Sign in",
        "category": "Atlarix"
      },
      {
        "command": "atlarix.showLog",
        "title": "Show log",
        "category": "Atlarix"
      },
      {
        "command": "atlarix.manageKeys",
        "title": "Models & keys",
        "category": "Atlarix",
        "icon": "$(key)"
      },
      {
        "command": "atlarix.pickModel",
        "title": "Pick a model",
        "category": "Atlarix"
      },
      {
        "command": "atlarix.insertReference",
        "title": "Add this file (and selection) to chat",
        "category": "Atlarix"
      },
      {
        "command": "atlarix.addProblems",
        "title": "Add problems to chat",
        "category": "Atlarix"
      },
      {
        "command": "atlarix.addTerminalSelection",
        "title": "Add to Atlarix chat",
        "category": "Atlarix"
      },
      {
        "command": "atlarix.settings",
        "title": "Settings",
        "category": "Atlarix",
        "icon": "$(gear)"
      },
      {
        "command": "atlarix.account",
        "title": "Account, usage and billing",
        "category": "Atlarix"
      },
      {
        "command": "atlarix.mcp",
        "title": "MCP servers",
        "category": "Atlarix"
      },
      {
        "command": "atlarix.automations",
        "title": "Automations",
        "category": "Atlarix"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "atlarix.newChat",
          "when": "view == atlarix.chat",
          "group": "navigation@1"
        },
        {
          "command": "atlarix.history",
          "when": "view == atlarix.chat",
          "group": "navigation@2"
        },
        {
          "command": "atlarix.openInTab",
          "when": "view == atlarix.chat",
          "group": "navigation@3"
        }
      ],
      "editor/context": [
        {
          "command": "atlarix.addSelection",
          "when": "editorHasSelection",
          "group": "atlarix@1"
        }
      ],
      "explorer/context": [
        {
          "command": "atlarix.addFile",
          "when": "!explorerResourceIsFolder",
          "group": "atlarix@1"
        }
      ],
      "terminal/context": [
        {
          "command": "atlarix.addTerminalSelection",
          "group": "atlarix@1"
        }
      ],
      "commandPalette": [
        {
          "command": "atlarix.addTerminalSelection",
          "when": "terminalFocus"
        }
      ]
    },
    "keybindings": [
      {
        "command": "atlarix.focus",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a"
      },
      {
        "command": "atlarix.addSelection",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l",
        "when": "editorHasSelection"
      },
      {
        "command": "atlarix.insertReference",
        "key": "alt+k",
        "mac": "alt+k",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Atlarix",
      "properties": {
        "atlarix.cliPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Path to an `atlarix` program to use instead of the one inside this extension."
        },
        "atlarix.attachOpenFile": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Offer the file open in the editor as context for each message (shown in the message box; remove it there to leave it out)."
        }
      }
    }
  },
  "devDependencies": {
    "@types/vscode": "1.90.0"
  },
  "qna": "https://github.com/AmariahAK/atlarix-releases/discussions",
  "activationEvents": [
    "onUri",
    "onStartupFinished"
  ]
}
