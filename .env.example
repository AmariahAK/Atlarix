# Atlarix Environment Configuration
# Copy this file to .env and add your actual API keys

# ═══════════════════════════════════════════════════════════
# AI PROVIDERS
# ═══════════════════════════════════════════════════════════

# OpenRouter (Cloud - 100+ models)
OPENROUTER_API_KEY=

# Ollama (Local - Free)
# Default: http://127.0.0.1:11434
OLLAMA_HOST=http://localhost:11434

# LMStudio (Local - Free)
# Default: http://127.0.0.1:1234
LMSTUDIO_HOST=http://localhost:1234

# ═══════════════════════════════════════════════════════════
# DATABASE & BACKEND
# ═══════════════════════════════════════════════════════════

# PostgreSQL Database (atlarix-db on Fly.io)
DATABASE_URL=postgres://postgres:TncDpqlkyV9Hw6j@atlarix-db.flycast:5432
DATABASE_SSL=false

# Backend API URL
ATLARIX_API_URL=https://atlarix-api.fly.dev

# ═══════════════════════════════════════════════════════════
# AUTHENTICATION
# ═══════════════════════════════════════════════════════════

# OAuth (Google & GitHub)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Lemon Squeezy (Payment Processing)
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=

# ═══════════════════════════════════════════════════════════
# WORKSPACE
# ═══════════════════════════════════════════════════════════

# Default workspace directory
DEFAULT_WORKSPACE=

# ═══════════════════════════════════════════════════════════
# DEVELOPER SETTINGS (Optional)
# ═══════════════════════════════════════════════════════════

# Node environment
# NODE_ENV=development

# Debug mode
# DEBUG=true