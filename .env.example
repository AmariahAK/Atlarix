# =============================================================================
# Atlarix Environment Variables
# =============================================================================
# Copy this file to .env and fill in values. Never commit .env or real secrets.
# For CI (GitHub Actions), add these as repository secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# LemonSqueezy (main process only; do not expose in renderer)
# -----------------------------------------------------------------------------
# Required for Pro checkout. Get from https://app.lemonsqueezy.com/settings/api
LEMONSQUEEZY_API_KEY=
# Optional; defaults used in app if not set
LEMONSQUEEZY_STORE_ID=236920
LEMONSQUEEZY_VARIANT_ID=1226325
# v4.0 Workforce: create products in LemonSqueezy dashboard (monthly only), then set variant IDs
LEMONSQUEEZY_WORKFORCE_VARIANT_ID=
LEMONSQUEEZY_EXTRA_SEAT_VARIANT_ID=
# Webhook signing secret from LemonSqueezy Dashboard > Webhooks
LEMONSQUEEZY_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Supabase (main app auth — OAuth handled by Supabase)
# -----------------------------------------------------------------------------
# Project URL and anon (publishable) key from Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
# Server-only: Supabase Dashboard > Settings > API > service_role (never ship to renderer)
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Vite / renderer (prefixed vars are exposed to client bundle)
# -----------------------------------------------------------------------------
# App is self-contained; auth and DB via Supabase. No separate API URL.

# -----------------------------------------------------------------------------
# Resend (team invite and status emails — v4.0)
# -----------------------------------------------------------------------------
# From https://resend.com — API key and verified sender. Used for invite, accept/reject/leave notifications.
RESEND_API_KEY=
# Sender address (e.g. Atlarix <noreply@yourdomain.com>). Must be a verified domain in Resend.
EMAIL_SOURCE=
# One-off outreach script (scripts/send-user-feedback-email.mjs)
# OUTREACH_FROM=Amariah <amariah@atlarix.dev>
# OUTREACH_REPLY_TO=amariah@atlarix.dev

# -----------------------------------------------------------------------------
# Sentry (error monitoring)
# -----------------------------------------------------------------------------
# From Sentry project settings. Optional for local dev.
SENTRY_DSN=

# -----------------------------------------------------------------------------
# PostHog (product analytics — only when user opts in via Settings)
# -----------------------------------------------------------------------------
# From PostHog project settings. Optional; if unset, analytics is no-op.
POSTHOG_API_KEY=

# -----------------------------------------------------------------------------
# Atlarix Core (managed provider — main process only, embedded at build time)
# -----------------------------------------------------------------------------
# Master OpenRouter key billed to Atlarix; never shipped to the renderer.
# (Name kept from the Compass era so existing CI secrets keep working.)
COMPASS_OPENROUTER_API_KEY=
# The four Core model slots, each an OpenRouter model id (e.g. deepseek/deepseek-v3.2).
# All plans see all four models; usage is metered by the shared Supabase token
# pool (compass_tokens table — limits live in Supabase, never hardcode here).
# Core 1 = fastest/cheapest ... Core 4 = most capable.
ATLARIX_CORE_MODEL_1=
ATLARIX_CORE_MODEL_2=
ATLARIX_CORE_MODEL_3=
ATLARIX_CORE_MODEL_4=

# -----------------------------------------------------------------------------
# GitHub API (optional — template list discovery in main process)
# -----------------------------------------------------------------------------
# Fine-grained or classic PAT; raises rate limits for api.github.com template searches.
TEMPLATE_TOKEN=

# OAuth App for Device Flow (clone / Connect to GitHub in app).
# Create at https://github.com/settings/applications/new — name it "Atlarix", enable Device Flow.
# Without this, the bundled legacy client shows "Authorize Dyad" on github.com.
OAUTH_CLIENT_ID=

# -----------------------------------------------------------------------------
# (No separate API URL — self-contained app; Supabase for auth and DB.)
# -----------------------------------------------------------------------------
