# =============================================================================
# Atlarix Environment Variables
# =============================================================================
# Copy this file to .env and fill in values. Never commit .env or real secrets.
# For CI (GitHub Actions), add these as repository secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# LemonSqueezy (main process only; do not expose in renderer)
# -----------------------------------------------------------------------------
# Required for Pro checkout. Get from https://app.lemonsqueezy.com/settings/api
LEMONSQUEEZY_API_KEY=
# Optional; defaults used in app if not set
LEMONSQUEEZY_STORE_ID=236920
LEMONSQUEEZY_VARIANT_ID=1226325
# v4.0 Workforce: create products in LemonSqueezy dashboard (monthly only), then set variant IDs
LEMONSQUEEZY_WORKFORCE_VARIANT_ID=
LEMONSQUEEZY_EXTRA_SEAT_VARIANT_ID=

# -----------------------------------------------------------------------------
# Auth0 Token Vault (v4.0 Workforce — agent authentication for extensions)
# -----------------------------------------------------------------------------
# From Auth0 Dashboard / Auth0 for AI Agents. Optional; if unset, app falls back to stored credentials.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_TOKEN_VAULT_ID=
AUTH0_AUDIENCE=

# -----------------------------------------------------------------------------
# Supabase (main app auth — Google/GitHub OAuth)
# -----------------------------------------------------------------------------
# Project URL and anon (publishable) key from Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# Google OAuth (Supabase handles flow; client ID used in app)
# -----------------------------------------------------------------------------
# From Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=
# Client secret: set in Supabase Dashboard > Auth > Providers > Google (not in .env for renderer)

# -----------------------------------------------------------------------------
# GitHub OAuth (Supabase handles flow; client ID used in app)
# -----------------------------------------------------------------------------
# From GitHub Developer Settings > OAuth Apps
GITHUB_CLIENT_ID=
# Client secret: set in Supabase Dashboard > Auth > Providers > GitHub (not in .env for renderer)

# -----------------------------------------------------------------------------
# Vite / renderer (prefixed vars are exposed to client bundle)
# -----------------------------------------------------------------------------
# Same OAuth client IDs for sign-in UI
VITE_GOOGLE_CLIENT_ID=
VITE_GITHUB_CLIENT_ID=
# Optional: backend API URL for device registration etc.
VITE_ATLARIX_API_URL=https://atlarix-api.fly.dev

# -----------------------------------------------------------------------------
# Resend (team invite and status emails — v4.0)
# -----------------------------------------------------------------------------
# From https://resend.com — API key and verified sender. Used for invite, accept/reject/leave notifications.
RESEND_API_KEY=
# Sender address (e.g. Atlarix <noreply@yourdomain.com>). Must be a verified domain in Resend.
EMAIL_SOURCE=

# -----------------------------------------------------------------------------
# Sentry (error monitoring)
# -----------------------------------------------------------------------------
# From Sentry project settings. Optional for local dev.
SENTRY_DSN=

# -----------------------------------------------------------------------------
# PostHog (product analytics — only when user opts in via Settings)
# -----------------------------------------------------------------------------
# From PostHog project settings. Optional; if unset, analytics is no-op.
POSTHOG_API_KEY=

# -----------------------------------------------------------------------------
# Optional: backend API base URL (main process)
# -----------------------------------------------------------------------------
ATLARIX_API_URL=https://atlarix-api.fly.dev
