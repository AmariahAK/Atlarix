/**
 * Templates Page
 * ===============
 * Browse and select project templates (IPC version)
 */

import { useState } from 'react';
import { TemplateBrowser } from '@/components/templates/TemplateBrowser';
import { Template } from '@/lib/templates/template-service';
import { Button } from '@/components/ui/button';
import { useNavigate } from '@tanstack/react-router';
import { Dialog, DialogContent, DialogDescription, DialogHeader, DialogTitle } from '@/components/ui/dialog';

export function TemplatesPage() {
    const [selectedTemplate, setSelectedTemplate] = useState<Template | null>(null);
    const [dialogOpen, setDialogOpen] = useState(false);
    const [cloning, setCloning] = useState(false);
    const [progress, setProgress] = useState(0);
    const [progressMessage, setProgressMessage] = useState('');
    const navigate = useNavigate();

    const handleSelectTemplate = (template: Template) => {
        setSelectedTemplate(template);
        setDialogOpen(true);
    };

    const handleCreateFromTemplate = async () => {
        if (!selectedTemplate || cloning) return;

        try {
            const electron = (window as any).electron;
            if (!electron) {
                alert('Electron API not available');
                return;
            }

            // Ask user where to create project
            const result = await electron.ipcRenderer.invoke('dialog:openDirectory');

            if (!result || result.canceled || !result.filePaths[0]) {
                return;
            }

            const targetDirectory = result.filePaths[0];
            const projectName = prompt('Enter project name:', selectedTemplate.name.replace(/[^a-zA-Z0-9-_]/g, '-'));

            if (!projectName) {
                return;
            }

            setCloning(true);
            setProgress(0);

            // Validate directory via IPC
            const validation = await electron.ipcRenderer.invoke('template:validate-directory', targetDirectory, projectName);
            if (!validation.valid) {
                alert(validation.error);
                setCloning(false);
                return;
            }

            // Listen for progress events
            const progressHandler = (_: any, progressUpdate: any) => {
                setProgress(progressUpdate.progress);
                setProgressMessage(progressUpdate.message);
            };
            electron.ipcRenderer.on('template:clone:progress', progressHandler);

            // Clone via IPC
            const cloneResult = await electron.ipcRenderer.invoke('template:clone', {
                targetDirectory,
                projectName,
                template: selectedTemplate,
            });

            // Remove progress listener
            electron.ipcRenderer.removeListener('template:clone:progress', progressHandler);

            if (cloneResult.success) {
                alert(`✅ Project created!\n\n${cloneResult.projectPath}\n\nYou can now open this folder in Atlarix.`);
                setDialogOpen(false);

                const openProject = confirm('Open this project now?');
                if (openProject) {
                    navigate({ to: '/' });
                }
            } else {
                alert(`❌ Failed:\n\n${cloneResult.error}`);
            }
        } catch (error: any) {
            console.error('Template error:', error);
            alert(`Error: ${error.message}`);
        } finally {
            setCloning(false);
            setProgress(0);
            setProgressMessage('');
        }
    };

    return (
        <div className="min-h-screen bg-background p-8">
            <div className="max-w-7xl mx-auto space-y-8">
                <div className="flex items-center justify-between">
                    <div>
                        <h1 className="text-4xl font-bold bg-gradient-to-r from-primary via-secondary to-primary bg-clip-text text-transparent">
                            Project Templates
                        </h1>
                        <p className="text-muted-foreground mt-2">
                            Start your next project with a battle-tested template
                        </p>
                    </div>
                    <Button onClick={() => navigate({ to: '/' })} variant="outline">
                        Back to Home
                    </Button>
                </div>

                <div className="axis-line-horizontal w-full h-px opacity-30" />

                <TemplateBrowser onSelectTemplate={handleSelectTemplate} />
            </div>

            <Dialog open={dialogOpen} onOpenChange={setDialogOpen}>
                <DialogContent className="max-w-2xl">
                    <DialogHeader>
                        <DialogTitle className="text-2xl">{selectedTemplate?.name}</DialogTitle>
                        <DialogDescription>{selectedTemplate?.description}</DialogDescription>
                    </DialogHeader>

                    {selectedTemplate && (
                        <div className="space-y-6 mt-4">
                            {cloning && (
                                <div className="rounded-lg border border-primary/20 bg-primary/5 p-4 space-y-3">
                                    <div className="flex items-center justify-between text-sm">
                                        <span className="font-medium">{progressMessage}</span>
                                        <span className="text-muted-foreground">{progress}%</span>
                                    </div>
                                    <div className="w-full bg-border rounded-full h-2">
                                        <div
                                            className="bg-primary rounded-full h-2 transition-all duration-300"
                                            style={{ width: `${progress}%` }}
                                        />
                                    </div>
                                </div>
                            )}

                            <div>
                                <h4 className="font-semibold mb-2">Tech Stack</h4>
                                <div className="flex flex-wrap gap-2">
                                    {selectedTemplate.tech_stack.map((tech) => (
                                        <span key={tech} className="px-3 py-1 rounded-full bg-primary/10 text-primary text-sm font-medium">
                                            {tech}
                                        </span>
                                    ))}
                                </div>
                            </div>

                            {selectedTemplate.features.length > 0 && (
                                <div>
                                    <h4 className="font-semibold mb-2">Features</h4>
                                    <ul className="list-disc list-inside space-y-1 text-muted-foreground">
                                        {selectedTemplate.features.map((feature) => (
                                            <li key={feature}>{feature}</li>
                                        ))}
                                    </ul>
                                </div>
                            )}

                            <div className="flex items-center gap-6 text-sm text-muted-foreground">
                                <div className="flex items-center gap-2">
                                    <svg className="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                                    </svg>
                                    <span>{selectedTemplate.stars.toLocaleString()} stars</span>
                                </div>
                                <div className="flex items-center gap-2">
                                    <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M13 10V3L4 14h7v7l9-11h-7z" />
                                    </svg>
                                    <span className="capitalize">{selectedTemplate.difficulty}</span>
                                </div>
                            </div>

                            <div className="flex gap-3 pt-4 border-t">
                                <Button onClick={handleCreateFromTemplate} className="flex-1 atlarix-glow" disabled={cloning}>
                                    {cloning ? 'Creating...' : 'Create Project'}
                                </Button>
                                <Button
                                    onClick={() => window.open(selectedTemplate.repo_url, '_blank')}
                                    variant="outline"
                                    className="flex-1"
                                    disabled={cloning}
                                >
                                    View on GitHub
                                </Button>
                            </div>
                        </div>
                    )}
                </DialogContent>
            </Dialog>
        </div>
    );
}
