{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/main.ts",
    "src/preload.ts",
    "src/preload-browser.ts",
    "src/router.ts",
    "src/routes/**/*.{ts,tsx}",
    "src/ipc/ipc_host.ts",
    "src/lib/tools/index.ts",
    "forge.config.ts",
    "vite.*.config.mts"
  ],
  "project": [
    "src/**/*.{ts,tsx}"
  ],
  "ignore": [
    "e2e-tests/**",
    "**/*.d.ts",
    "src/**/*.test.{ts,tsx}",
    "src/__tests__/renderer/stubs/**",
    "src/shims/**"
  ],
  "ignoreDependencies": [
    "@ast-grep/lang-go",
    "@ast-grep/lang-python",
    "shiki",
    "tw-animate-css",
    "typescript-language-server",
    "vscode-langservers-extracted",
    "@electron-forge/publisher-github",
    "@electron-forge/shared-types",
    "@electron-forge/core-utils",
    "@electron/get",
    "@electron/packager",
    "@tailwindcss/typography",
    "@shikijs/themes",
    "@shikijs/langs",
    "hast",
    "lint-staged"
  ],
  "ignoreBinaries": [
    "tsx",
    "ts-node"
  ],
  "ignoreUnresolved": [
    "../../worker/proxy_server.js"
  ],
  "ignoreExportsUsedInFile": true
}
